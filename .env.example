# ==============================================================================
# CẤU HÌNH BIẾN MÔI TRƯỜNG - I'M TUNG PHOTOGRAPHER
# Sao chép file này thành .env.local để sử dụng khi chạy trên máy hoặc triển khai:
# cp .env.example .env.local
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. CẤU HÌNH TÊN MIỀN & SEO (TÙY CHỌN)
# ------------------------------------------------------------------------------
# Tên miền website thật (không có dấu gạch chéo cuối).
# Khi có tên miền: canonical URL và sitemap.xml sẽ được kích hoạt tự động.
# Nếu để trống: không xuất canonical và sitemap nhằm tránh tự bịa domain.
# Ví dụ: NEXT_PUBLIC_SITE_URL=https://imtungphotographer.vn
NEXT_PUBLIC_SITE_URL=

# Cho phép Google / công cụ tìm kiếm lập chỉ mục (index).
# Mặc định: false (chặn robot qua robots.txt khi website đang dùng ảnh & nội dung demo).
# Đổi thành true khi đã thay toàn bộ ảnh demo bằng tác phẩm thật của Tung.
NEXT_PUBLIC_ALLOW_INDEXING=false


# ------------------------------------------------------------------------------
# 2. LƯU TRỮ & THÔNG BÁO LEAD TƯ VẤN (MIỄN PHÍ 100% - CHỌN 1 HOẶC KẾT HỢP)
# ------------------------------------------------------------------------------
# Nếu chưa cấu hình: website sẽ ở chế độ "Xem thử (demo)" và hướng dẫn khách gọi Zalo.
# Chỉ cần cấu hình ÍT NHẤT 1 trong các cách sau là form sẽ hoạt động thật!

# CÁCH 1: BÁO VỀ TELEGRAM (KHUYÊN DÙNG NHẤT - RUNG ĐIỆN THOẠI TRONG 1 GIÂY, MIỄN PHÍ 100%)
# 1. Mở Telegram, tìm bot @BotFather -> gõ /newbot để tạo bot và lấy TOKEN.
# 2. Tìm bot @userinfobot -> bấm Start để lấy Chat ID của bạn.
# 3. Bấm Start vào bot vừa tạo của bạn.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# CÁCH 2: TỰ ĐỘNG LƯU VÀO GOOGLE SHEETS & BÁO EMAIL GMAIL (MIỄN PHÍ 100%)
# Xem hướng dẫn chi tiết và code mẫu có sẵn tại: scripts/google-sheet-lead-collector.js
# LEAD_WEBHOOK_URL=https://script.google.com/macros/s/.../exec
# LEAD_WEBHOOK_SECRET=chuoi-bi-mat-tuy-chon
LEAD_WEBHOOK_URL=
LEAD_WEBHOOK_SECRET=

# CÁCH 3: LƯU VÀO CƠ SỞ DỮ LIỆU SUPABASE (MIỄN PHÍ 500MB)
# Xem hướng dẫn và script SQL tạo bảng tại: scripts/supabase-schema.sql
# SUPABASE_URL=https://xyzcompany.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...
# SUPABASE_LEADS_TABLE=leads
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_LEADS_TABLE=leads

